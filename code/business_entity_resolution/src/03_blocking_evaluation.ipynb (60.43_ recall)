":"code","source":"import re\nimport unicodedata\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nROOT = Path(\n    \"/kaggle/input/datasets/archangel26/\"\n    \"infinity8-amazon-ml-challenge/student_resource\"\n)\n\nTRAIN_DIR = ROOT / \"dataset\" / \"train\"\n\nprint(\"Blocking notebook initialized.\")\nprint(\"Training directory:\", TRAIN_DIR)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-27T07:34:29.034171Z","iopub.execute_input":"2026-09-27T07:34:29.034708Z","iopub.status.idle":"2026-09-27T07:34:29.041155Z","shell.execute_reply.started":"2026-09-27T07:34:29.034673Z","shell.execute_reply":"2026-09-27T07:34:29.040214Z"}},"outputs":[{"name":"stdout","text":"Blocking notebook initialized.\nTraining directory: /kaggle/input/datasets/archangel26/infinity8-amazon-ml-challenge/student_resource/dataset/train\n","output_type":"stream"}],"execution_count":2},{"cell_type":"markdown","source":"## 2. Load Training Datasets\n\nLoad the three training sources and the ground truth.\n\nThe ground truth will later be used to measure how many true matches\nsurvive each blocking strategy.","metadata":{}},{"cell_type":"code","source":"train_s1 = pd.read_csv(\n    TRAIN_DIR / \"train_source1.tsv\",\n    sep=\"\\t\",\n    dtype=str\n)\n\ntrain_s2 = pd.read_csv(\n    TRAIN_DIR / \"train_source2.tsv\",\n    sep=\"\\t\",\n    dtype=str\n)\n\ntrain_s3 = pd.read_csv(\n    TRAIN_DIR / \"train_source3.tsv\",\n    sep=\"\\t\",\n    dtype=str\n)\n\nground_truth = pd.read_csv(\n    TRAIN_DIR / \"train_ground_truth.tsv\",\n    sep=\"\\t\",\n    dtype=str\n)\n\nprint(f\"S1: {train_s1.shape}\")\nprint(f\"S2: {train_s2.shape}\")\nprint(f\"S3: {train_s3.shape}\")\nprint(f\"GT: {ground_truth.shape}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-27T07:34:29.042295Z","iopub.execute_input":"2026-09-27T07:34:29.042664Z","iopub.status.idle":"2026-09-27T07:35:16.793199Z","shell.execute_reply.started":"2026-09-27T07:34:29.042614Z","shell.execute_reply":"2026-09-27T07:35:16.792388Z"}},"outputs":[{"name":"stdout","text":"S1: (2206821, 4)\nS2: (5034616, 4)\nS3: (5285603, 4)\nGT: (2206821, 2)\n","output_type":"stream"}],"execution_count":3},{"cell_type":"markdown","source":"## 3. Define Unicode-Safe Normalization\n\nBlocking depends on consistent text representations.\n\nThe normalization preserves Unicode letters, numbers, and combining marks\nso multilingual business names are not reduced to damaged ASCII-like text.","metadata":{}},{"cell_type":"code","source":"def normalize_unicode_text(text):\n    if pd.isna(text):\n        return \"\"\n\n    text = str(text).strip().lower()\n    text = unicodedata.normalize(\"NFKC\", text)\n    text = text.replace(\"&\", \" and \")\n\n    cleaned = []\n\n    for char in text:\n        category = unicodedata.category(char)\n\n        if char.isspace():\n            cleaned.append(\" \")\n        elif category[0] in (\"L\", \"N\", \"M\"):\n            cleaned.append(char)\n        else:\n            cleaned.append(\" \")\n\n    text = \"\".join(cleaned)\n\n    return re.sub(r\"\\s+\", \" \", text).strip()\n\n\ndef add_blocking_fields(df):\n    df[\"name_norm\"] = (\n        df[\"business_name\"]\n        .fillna(\"\")\n        .map(normalize_unicode_text)\n    )\n\n    df[\"address_norm\"] = (\n        df[\"business_address\"]\n        .fillna(\"\")\n        .map(normalize_unicode_text)\n    )\n\n    df[\"country_key\"] = (\n        df[\"country\"]\n        .fillna(\"\")\n        .str.strip()\n        .str.lower()\n    )\n\n    df[\"name_first_token\"] = (\n        df[\"name_norm\"]\n        .str.split()\n        .str[0]\n        .fillna(\"\")\n    )\n\n\nfor df in [train_s1, train_s2, train_s3]:\n    add_blocking_fields(df)\n\nprint(\"Blocking fields created.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-27T07:35:16.795586Z","iopub.execute_input":"2026-09-27T07:35:16.795871Z","iopub.status.idle":"2026-09-27T07:40:34.497373Z","shell.execute_reply.started":"2026-09-27T07:35:16.795844Z","shell.execute_reply":"2026-09-27T07:40:34.496254Z"}},"outputs":[{"name":"stdout","text":"Blocking fields created.\n","output_type":"stream"}],"execution_count":4},{"cell_type":"markdown","source":"## 4. Verify Training Data Only","metadata":{}},{"cell_type":"code","source":"expected_rows = {\n    \"train_s1\": 2_206_821,\n    \"train_s2\": 5_034_616,\n    \"train_s3\": 5_285_603,\n    \"ground_truth\": 2_206_821,\n}\n\nassert len(train_s1) == expected_rows[\"train_s1\"]\nassert len(train_s2) == expected_rows[\"train_s2\"]\nassert len(train_s3) == expected_rows[\"train_s3\"]\nassert len(ground_truth) == expected_rows[\"ground_truth\"]\n\nrequired_fields = [\n    \"name_norm\",\n    \"address_norm\",\n    \"country_key\",\n    \"name_first_token\",\n]\n\nfor name, df in {\n    \"train_s1\": train_s1,\n    \"train_s2\": train_s2,\n    \"train_s3\": train_s3,\n}.items():\n    missing = [\n        col for col in required_fields\n        if col not in df.columns\n    ]\n\n    assert not missing, (\n        f\"{name} missing fields: {missing}\"\n    )\n\nprint(\"Blocking validation passed.\")\nprint()\nprint(f\"Train S1 rows: {len(train_s1):,}\")\nprint(f\"Train S2 rows: {len(train_s2):,}\")\nprint(f\"Train S3 rows: {len(train_s3):,}\")\nprint(f\"Ground truth rows: {len(ground_truth):,}\")\nprint()\nprint(\"Training data only.\")\nprint(\"No test data loaded or processed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-27T07:40:34.498546Z","iopub.execute_input":"2026-09-27T07:40:34.498820Z","iopub.status.idle":"2026-09-27T07:40:35.037255Z","shell.execute_reply.started":"2026-09-27T07:40:34.498793Z","shell.execute_reply":"2026-09-27T07:40:35.036309Z"}},"outputs":[{"name":"stdout","text":"Blocking validation passed.\n\nTrain S1 rows: 2,206,821\nTrain S2 rows: 5,034,616\nTrain S3 rows: 5,285,603\nGround truth rows: 2,206,821\n\nTraining data only.\nNo test data loaded or processed.\n","output_type":"st